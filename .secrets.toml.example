# copy this file to .streamlit/secrets.toml for running locally
# or paste the same contents into Streamlit Cloud > App settings > Secrets.
# fill in every value from the service account JSON key downloaded.

[google_sheet]
# From the sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
spreadsheet_id = ""

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
